# ============================================================
# Pokedex — Variables de entorno para PRODUCCIÓN / SERVIDOR
# Copia este archivo a `.env` en la raíz del repo del servidor
# y rellena TODOS los valores antes de hacer el build.
#
# ⚠  NUNCA subas este archivo con valores reales al repositorio.
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=pokedex_user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_PASSWORD_SEGURO
POSTGRES_DB=pokedex

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIA_ESTO_POR_PASSWORD_REDIS_SEGURO

# ── Backend (FastAPI) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pokedex_user:CAMBIA_ESTO_POR_PASSWORD_SEGURO@postgres:5432/pokedex
REDIS_URL=redis://:CAMBIA_ESTO_POR_PASSWORD_REDIS_SEGURO@redis:6379/0

# Clave secreta para firmar JWT. OBLIGATORIA.
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GENERA_UNA_CLAVE_LARGA_Y_ALEATORIA

# ── CORS y Hosts ─────────────────────────────────────────────
# El frontend llama al backend a través de Nginx en /api/
# así que solo el dominio público entra como CORS permitido.
CORS_ORIGINS=https://ultimate-poke.sytes.net

# Hosts permitidos por TrustedHostMiddleware (sin protocolo, sin puerto).
ALLOWED_HOSTS=localhost,127.0.0.1,ultimate-poke.sytes.net

# ── Frontend (Next.js) — NO se usa aquí ──────────────────────
# El frontend corre fuera de Docker (PM2). Su variable de entorno
# NEXT_PUBLIC_API_URL se configura en frontend/ecosystem.config.js
# Valor esperado: https://ultimate-poke.sytes.net/api
