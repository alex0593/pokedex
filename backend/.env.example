# ============================================================
# Pokedex Backend — variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# El archivo `.env` está en .gitignore y NO debe subirse al repo.
# ============================================================

# Conexión a la base de datos PostgreSQL local (Docker).
# Driver requerido: asyncpg (postgresql+asyncpg://...).
# Dev local (docker-compose):  postgresql+asyncpg://pokedex_user:pokedex_password_dev@postgres:5432/pokedex
# Producción:                  postgresql+asyncpg://prod_user:prod_password@prod-host:5432/prod_db
DATABASE_URL=postgresql+asyncpg://pokedex_user:pokedex_password_dev@postgres:5432/pokedex

# Redis — Cache y sesiones (opcional, requerido para Bloque 5+)
# Dev local:     redis://:pokedex_redis_pass_dev@redis:6379/0
# Sin password:  redis://redis:6379/0
REDIS_URL=redis://:pokedex_redis_pass_dev@redis:6379/0

# Clave secreta para firmar JWT. OBLIGATORIA — la app no arranca sin esto.
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Orígenes permitidos por CORS (coma-separados, sin espacios).
# OBLIGATORIO — la app no arranca sin esto.
# Ejemplo dev:  CORS_ORIGINS=http://localhost:3000
# Ejemplo prod: CORS_ORIGINS=https://pokedex.midominio.com,https://www.pokedex.midominio.com
CORS_ORIGINS=http://localhost:3000

# Hosts permitidos por TrustedHostMiddleware (coma-separados, sin protocolo).
# Dev:  ALLOWED_HOSTS=localhost,127.0.0.1
# Prod: ALLOWED_HOSTS=localhost,127.0.0.1,mi-servidor.com
ALLOWED_HOSTS=localhost,127.0.0.1
