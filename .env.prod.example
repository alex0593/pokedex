# ============================================================
# Variables de producción — raíz del proyecto
# Copia a .env y rellena los valores reales:
#   cp .env.prod.example .env
# El .env real está en .gitignore
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=pokedex_user
POSTGRES_PASSWORD=cambia_esto_contraseña_fuerte_32chars
POSTGRES_DB=pokedex

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=cambia_esto_contraseña_redis_fuerte

# ── Backend FastAPI ───────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia_esto_clave_jwt_64_chars_minimo

CORS_ORIGINS=https://ultimate-poke.sytes.net
ALLOWED_HOSTS=localhost,127.0.0.1,ultimate-poke.sytes.net
ENVIRONMENT=production
